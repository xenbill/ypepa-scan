{
  // Production (IIS) overrides. Writable data lives OUTSIDE the site folder so
  // redeploys never wipe logs or the tile cache, and the site folder can stay
  // read-only. Grant the app pool identity Modify on the data folder only:
  //   icacls "D:\SxediaData" /grant "IIS AppPool\SxediaPool:(OI)(CI)M"

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "D:\\SxediaData\\logs\\log-.txt",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Information",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },

  "Storage": {
    "Mode": "Oracle"
  },

  "Oracle": {
    // FILL IN before going live, e.g.
    // "User Id=CCC;Password=***;Data Source=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=gea-prod01...)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=...)))"
    "ConnectionString": "",
    "Owner": "CCC",
    "CommonOwner": "COMMON"
  },

  "Cache": {
    "Dir": "D:\\SxediaData\\tile-cache",
    "MaxMegabytes": 2000
  }

  // Reminder: change Jwt:Key and the Auth:* dev credentials before production.
}
