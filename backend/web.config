<?xml version="1.0" encoding="utf-8"?>
<!-- IIS deployment settings. Published as-is by dotnet publish. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- in-process hosting: relative paths resolve to the app folder -->
      <aspNetCore processPath="dotnet"
                  arguments=".\Mis.YpepaScan.Web.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess" />
      <security>
        <requestFiltering>
          <!-- Allow large TIFF/PDF imports (500 MB) — IIS default is ~30 MB.
               Must match the Kestrel/form limits set in Program.cs. -->
          <requestLimits maxAllowedContentLength="524288000" />
        </requestFiltering>
      </security>
      <!-- Warm-up: boots the in-process .NET app without waiting for a real user,
           and re-warms it after every app-pool recycle. REQUIRES the IIS
           "Application Initialization" module (Web-AppInit) — without it, IIS
           fails the site with 500.19. Pair with app-pool startMode=AlwaysRunning,
           idleTimeout=0 and site preloadEnabled=true; see docs/iis-setup.md. -->
      <applicationInitialization doAppInitAfterRestart="true">
        <add initializationPage="/" />
        <add initializationPage="/api/auth/mode" />
      </applicationInitialization>
    </system.webServer>
  </location>
</configuration>
