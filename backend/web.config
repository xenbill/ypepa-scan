<?xml version="1.0" encoding="utf-8"?>
<!-- IIS deployment settings. Published as-is by dotnet publish. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- in-process hosting: relative paths resolve to the app folder -->
      <aspNetCore processPath="dotnet"
                  arguments=".\Mis.YpepaScan.Web.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess" />
      <security>
        <requestFiltering>
          <!-- Allow large TIFF/PDF imports (500 MB) — IIS default is ~30 MB.
               Must match the Kestrel/form limits set in Program.cs. -->
          <requestLimits maxAllowedContentLength="524288000" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
